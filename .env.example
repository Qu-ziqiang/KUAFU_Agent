# DeepSeek（OpenAI 兼容）。模型用 deepseek-flash，便宜档。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash

# Tavily 搜索 API。前缀一般是 tvly-dev-（开发）或 tvly-prod-（生产）。
TAVILY_API_KEY=

# Agent 步数与检索（都可改；以后可按用户画像覆盖域名）
MAX_AGENT_STEPS=6
SEARCH_MAX_RESULTS=5
# 国内方案：轮数少、总时长短。国外方案仅在自定义要求「只看国外」时启用。
SEARCH_MAX_ROUNDS=2
FOREIGN_SEARCH_ROUNDS=4
DOMESTIC_TIMEOUT_SECONDS=120
FOREIGN_TIMEOUT_SECONDS=300
BRIEFING_MIN_ITEMS=3
# 搜到这么多条（有标题和摘要）就直接召回，不再等模型继续翻网页
BRIEFING_MAX_ITEMS=5
# 逗号分隔；中文优先站点。留空则用代码内默认列表。
SEARCH_PREFERRED_DOMAINS=jiqizhixin.com,qbitai.com,36kr.com,tmtpost.com,leiphone.com,wallstreetcn.com,caixin.com,qq.com,cls.cn,thepaper.cn,sohu.com,cctv.com,people.com.cn,xinhuanet.com,chinanews.com.cn,163.com,sina.com.cn,ifeng.com,gmw.cn,1905.com,douban.com,weibo.com,bilibili.com,mgtv.com,iqiyi.com,youku.com,mtime.com,maoyan.com,yangshipin.cn,ent.sina.com.cn,yule.sohu.com,ent.163.com,ent.qq.com,ent.ifeng.com

# 体感时限：多少秒内必须先出一版；总等待上限
FIRST_READY_SECONDS=60
TOTAL_TIMEOUT_SECONDS=180

# 可选。设为 0-23 则进程内每天该小时（服务器本地时区）为所有用户跑一次简报。
DAILY_HOUR=
